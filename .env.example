# Local Docker MySQL for this app. Host 3308 (3306 is often the existing Advisorkhoj MySQL).
DATABASE_URL=mysql://mfd:mfd@127.0.0.1:3308/mfd

# JWT cookie for Buyer Place. Generate a long random string.
AUTH_SECRET=change-me

# Host routing: app.{base} = editor, {slug}.{base} = public site, {base} = signup.
HOST_BASE=localhost
HOST_PROTOCOL=http
HOST_PORT=3000
# COOKIE_DOMAIN=.example.com

# Dev OTP: code is logged and returned in the send response. OTP_DEV_CODE always works.
OTP_DEV=1
OTP_DEV_CODE=000000

# Billing. Without Razorpay keys, local checkout confirms a test payment (non-production).
BILLING_DEV=1
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_MONTHLY=
# RAZORPAY_PLAN_YEARLY=
# Optional combo plans when add-ons are selected. Falls back to the base plan if unset.
# RAZORPAY_PLAN_MONTHLY_TOOLS=
# RAZORPAY_PLAN_YEARLY_TOOLS=
# RAZORPAY_PLAN_MONTHLY_BILINGUAL=
# RAZORPAY_PLAN_YEARLY_BILINGUAL=
# RAZORPAY_PLAN_MONTHLY_TOOLS_BILINGUAL=
# RAZORPAY_PLAN_YEARLY_TOOLS_BILINGUAL=

# Ops admin at /admin on the apex host (not on tenant slugs). Required in production.
# Local default is "admin" if this is unset.
ADMIN_SECRET=admin

# Optional Advisorkhoj calculator API. If unset, the BFF uses local illustrations.
# TOOLS_API_BASE=https://tools.example.com
# TOOLS_API_KEY=

# Optional S3/R2. If unset, uploads go to apps/web/public/uploads.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_PUBLIC_BASE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Staging: wildcard DNS *.HOST_BASE → this app, wildcard TLS, then:
# HOST_PROTOCOL=https
# HOST_PORT=
# COOKIE_DOMAIN=.your-base.example
# NODE_ENV=production
# OTP_DEV=0
# BILLING_DEV=0
# WhatsApp handoff is wa.me from the public site; no Cloud API key required.
