# Local Docker MySQL for this app. Host 3308 (3306 is often the existing Advisorkhoj MySQL).
DATABASE_URL=mysql://mfd:mfd@127.0.0.1:3308/mfd

# JWT cookie for Buyer Place. Generate a long random string.
AUTH_SECRET=change-me

# Host routing: app.{base} = editor, {slug}.{base} = public site, {base} = signup.
HOST_BASE=localhost
HOST_PROTOCOL=http
HOST_PORT=3000
# COOKIE_DOMAIN=.example.com

# Dev OTP: code is logged and returned in the send response. OTP_DEV_CODE always works.
OTP_DEV=1
OTP_DEV_CODE=000000

# Optional Advisorkhoj calculator API. If unset, the BFF uses local illustrations.
# TOOLS_API_BASE=https://tools.example.com
# TOOLS_API_KEY=

# Optional S3/R2. If unset, uploads go to apps/web/public/uploads.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_PUBLIC_BASE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
